{
  "tools": [
    {
      "code": 20000,
      "description": "Connect as an app widget on behalf of an end-user, declaring the app and user public ids. Runs at WebSocket handshake time via the Sec-WebSocket-Protocol header; not callable as a tool.",
      "frontendFacing": true,
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "appPublicId": {
            "maxLength": 16,
            "minLength": 16,
            "pattern": "^[0-9A-Za-z]+$",
            "type": "string"
          },
          "userPublicId": {
            "maxLength": 16,
            "minLength": 16,
            "pattern": "^[0-9A-Za-z]+$",
            "type": "string"
          }
        },
        "required": [
          "appPublicId",
          "userPublicId"
        ],
        "type": "object"
      },
      "name": "app_connect",
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "appName": {
            "type": "string"
          },
          "appPublicId": {
            "maxLength": 16,
            "minLength": 16,
            "pattern": "^[0-9A-Za-z]+$",
            "type": "string"
          }
        },
        "required": [
          "appPublicId"
        ],
        "type": "object"
      }
    }
  ]
}