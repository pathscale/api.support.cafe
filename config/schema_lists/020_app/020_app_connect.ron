#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]

Config(
    definition: EndpointSchemaList(
        service_name: "appConnect",
        service_id: 2,
        config: (snake_case_fields: true),
        endpoints: [
            EndpointSchemaElement(
                frontend_facing: true,
                schema: (
                    name: "AppConnect",
                    code: 20000,
                    description: "Connect as an anonymous visitor. Omit both visitor fields for a new identity, or supply the server-issued ID and secret to reconnect. WebSocket handshake only.",
                    parameters: [
                        Field(name: "app_public_id", ty: NanoId(len: 16)),
                        Field(name: "user_public_id", ty: Optional(NanoId(len: 16))),
                        Field(name: "visitor_secret", ty: Optional(String)),
                    ],
                    returns: [
                        Field(name: "app_public_id", ty: NanoId(len: 16)),
                        Field(name: "app_name", ty: Optional(String)),
                        Field(name: "user_public_id", ty: NanoId(len: 16)),
                        Field(name: "visitor_secret", ty: Optional(String)),
                    ],
                    roles: ["UserRole::Public"],
                ),
            ),
        ],
    ),
)
