#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]

Config(
    definition: EndpointSchemaList(
        service_name: "appAdminApi",
        service_id: 3,
        config: (snake_case_fields: true),
        endpoints: [
            EndpointSchemaElement(
                frontend_facing: true,
                schema: (
                    name: "CreateApp",
                    code: 30000,
                    parameters: [
                        Field(name: "tg_bot_token", ty: String),
                        Field(name: "app_name", ty: Optional(String)),
                    ],
                    returns: [
                        Field(name: "app_public_id", ty: NanoId(len: 16)),
                        Field(name: "created_at", ty: TimeStampMs),
                    ],
                    roles: ["UserRole::Admin", "UserRole::AppAdmin"],
                ),
            ),
            EndpointSchemaElement(
                frontend_facing: true,
                schema: (
                    name: "EditApp",
                    code: 30001,
                    parameters: [
                        Field(name: "app_public_id", ty: NanoId(len: 16)),
                        Field(name: "tg_bot_token", ty: Optional(String)),
                        Field(name: "app_name", ty: Optional(String)),
                        Field(name: "active", ty: Optional(Boolean)),
                    ],
                    returns: [],
                    roles: ["UserRole::Admin", "UserRole::AppAdmin"],
                ),
            ),
            EndpointSchemaElement(
                frontend_facing: true,
                schema: (
                    name: "ListApps",
                    code: 30002,
                    parameters: [],
                    returns: [
                        Field(
                            name: "data",
                            ty: StructTable(struct_ref: "AppConfig"),
                        ),
                    ],
                    roles: ["UserRole::Admin", "UserRole::AppAdmin"],
                ),
            ),
            EndpointSchemaElement(
                frontend_facing: true,
                schema: (
                    name: "EnableSupportUser",
                    code: 30003,
                    parameters: [
                        Field(name: "app_public_id", ty: NanoId(len: 16)),
                        Field(name: "user_pub_id", ty: NanoId(len: 16)),
                    ],
                    returns: [],
                    roles: ["UserRole::Admin", "UserRole::AppAdmin"],
                ),
            ),
            EndpointSchemaElement(
                frontend_facing: true,
                schema: (
                    name: "DisableSupportUser",
                    code: 30005,
                    parameters: [
                        Field(name: "app_public_id", ty: NanoId(len: 16)),
                        Field(name: "user_pub_id", ty: NanoId(len: 16)),
                    ],
                    returns: [],
                    roles: ["UserRole::Admin", "UserRole::AppAdmin"],
                ),
            ),
            EndpointSchemaElement(
                frontend_facing: true,
                schema: (
                    name: "AddAppMember",
                    code: 30006,
                    parameters: [
                        Field(name: "app_public_id", ty: NanoId(len: 16)),
                        Field(name: "user_pub_id", ty: NanoId(len: 16)),
                    ],
                    returns: [],
                    roles: ["UserRole::Admin", "UserRole::AppAdmin"],
                ),
            ),
            EndpointSchemaElement(
                frontend_facing: true,
                schema: (
                    name: "SetAppMemberRole",
                    code: 30007,
                    parameters: [
                        Field(name: "app_public_id", ty: NanoId(len: 16)),
                        Field(name: "user_pub_id", ty: NanoId(len: 16)),
                        Field(name: "role", ty: EnumRef(name: "AppMemberRole")),
                    ],
                    returns: [],
                    roles: ["UserRole::Admin", "UserRole::AppAdmin"],
                ),
            ),
            EndpointSchemaElement(
                frontend_facing: true,
                schema: (
                    name: "ListAppMembers",
                    code: 30008,
                    parameters: [
                        Field(name: "app_public_id", ty: NanoId(len: 16)),
                    ],
                    returns: [
                        Field(
                            name: "data",
                            ty: StructTable(struct_ref: "AppMember"),
                        ),
                    ],
                    roles: ["UserRole::Admin", "UserRole::AppAdmin", "UserRole::Support"],
                ),
            ),
        ],
    ),
)
