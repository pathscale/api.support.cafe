#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]

Config(
    definition: EndpointSchemaList(
        service_name: "adminApi",
        service_id: 4,
        config: (snake_case_fields: true),
        endpoints: [
            EndpointSchemaElement(
                frontend_facing: true,
                schema: (
                    name: "DeleteApp",
                    code: 40000,
                    description: "Delete an app, its memberships, and stop its Telegram bot. Only the app Owner may call this. Existing sessions and messages are not cascaded.",
                    parameters: [
                        Field(name: "app_public_id", ty: NanoId(len: 16)),
                    ],
                    returns: [],
                    roles: ["UserRole::Admin", "UserRole::AppAdmin"],
                ),
            ),
            EndpointSchemaElement(
                frontend_facing: true,
                schema: (
                    name: "SetLogLevel",
                    code: 40001,
                    description: "Change the server's log level at runtime (platform admin only).",
                    parameters: [
                        Field(name: "level", ty: EnumRef(name: "LogLevel")),
                    ],
                    returns: [],
                    roles: ["UserRole::Admin"],
                ),
            ),
            EndpointSchemaElement(
                frontend_facing: true,
                schema: (
                    name: "GetUsers",
                    code: 40002,
                    description: "List all registered users with their platform roles (platform admin only).",
                    parameters: [],
                    returns: [
                        Field(name: "data", ty: StructTable(struct_ref: "UserInfo")),
                    ],
                    roles: ["UserRole::Admin"],
                ),
            ),
            EndpointSchemaElement(
                frontend_facing: true,
                schema: (
                    name: "SetRole",
                    code: 40003,
                    description: "Override a user's platform role (platform admin only).",
                    parameters: [
                        Field(name: "user_pub_id", ty: NanoId(len: 16)),
                        Field(name: "role", ty: EnumRef(name: "UserRole")),
                    ],
                    returns: [],
                    roles: ["UserRole::Admin"],
                ),
            ),
            EndpointSchemaElement(
                frontend_facing: true,
                schema: (
                    name: "GetAllApps",
                    code: 40004,
                    description: "List all apps on the platform (platform admin only).",
                    parameters: [],
                    returns: [
                        Field(name: "data", ty: StructTable(struct_ref: "AppInfo")),
                    ],
                    roles: ["UserRole::Admin"],
                ),
            ),
        ],
    ),
)
